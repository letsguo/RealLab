<launch>
    <arg name="visualize" default="true" />
    <arg name="data" default="false" />
    <arg name="robot_name" default="hound_vio" />
    <arg name="moving_object" default="hound2" />
    <arg name="policy" default="drift" />
    <!-- <arg name="policy" default="gail" /> -->
    <arg name="mocap" default="true" />
    <arg name="odom_topic" value="$(eval '/mavros/local_position/odom' if '$(arg mocap)'=='true' else '/car/vesc/odom')"/>
    
    <group if="$(arg mocap)">
        <!-- Robot pose -> /mocap/local_position/odom -->
        <include file="$(find mushr_mocap)/launch/car_odom_publisher.launch">
            <arg name="asset_name" value="$(arg robot_name)" />
        </include>
        <!-- Obstacle poses -> /mocap/obstacle_*/pose -->
        <include file="$(find dbf)/launch/object_pose_publisher.launch">
            <arg name="asset_name" value="$(arg robot_name)" />
        </include>
    </group>        

    <include file="$(find dbf)/launch/realsense_d455_HOUND.launch"/>
    <include file="$(find mushr_base)/launch/teleop.launch"/>

    <arg name="low_level_Config" default="$(find dbf)/config/low_level_Config_real.yaml" />
    <rosparam file="$(arg low_level_Config)" command="load" />
    
    <!-- <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="15 elevation_mapping_cupy elevation_mapping_cupy_no_vis.launch" name="elevation_mapping" output="log"/>
    <include file="$(find ntrip_ros)/launch/ntripclient.launch"/>  -->

    <!-- <node pkg="dbf" type="gail_hl_control.py" name="high_level_controller" output="screen">
        <param name="policy" value="$(arg policy)" />
    </node> -->

    <!-- <node pkg="dbf" type="gail_hl_control.py" name="high_level_controller" output="screen">
        <param name="policy" value="$(arg policy)" />
        <param name="data_collection" value="$(arg data)" /> 
        <param name="odom" value="$(arg odom_topic)"/> 
        <param name="use_mocap" value="$(arg mocap)"/>
    </node> -->
   
    <group if ="$(arg data)">
        <!-- <node pkg="dbf" type="data_collector.py" name="data_collector" output="screen"/> -->
        <node pkg="dbf" type="img_recorder.py" name="img_recorder" output="screen"/>
    </group>
    
    <!-- <node pkg="dbf" type="teleop.py" name="teleop" output="screen"/> -->
    <!-- <node pkg="dbf" type="irl_mpc_control.py" name="high_level_controller" output="screen"/> -->
    <!-- <node pkg="dbf" type="rl_hl_control.py" name="high_level_controller" output="screen"> -->
    <node pkg="dbf" type="mpail_hl_control.py" name="high_level_controller" output="screen">
        <param name="policy" value="$(arg policy)" />
        <param name="data_collection" value="$(arg data)" /> 
        <param name="odom" value="$(arg odom_topic)"/> 
        <param name="use_mocap" value="$(arg mocap)"/>
        <param name="record_rollout_video" value="true"/>
        <param name="rollout_vis_dir" value="$(find dbf)/rollout_vis"/>
        <param name="video_fps" value="10"/>
    </node>

    <!-- comment the line below if you want to record data into rosbag-->
        <!-- <node pkg="dbf" type="expert_recorder_odom.py" name="recorder" output="screen">
            <param name="bag_file" value="$(env HOME)/catkin_ws/src/RealLab/dbf_expert_demonstrations/expert_complete_left.bag" />
        </node> -->

    <!-- OLD MPPI-->
    <!-- <node pkg="dbf" type="mppi_hl_control.py" name="high_level_controller" output="screen"/> -->


    <!-- Group of nodes launched only if visualize is true -->
    <group if="$(arg visualize)">
        <node pkg="dbf" type="state_spliter.py" name="state_splitter" output="screen" />
        <node pkg="hound_core" type="pose_republisher.py" name="pose_republisher" output="screen" /> 
        <node pkg="hound_core" type="action_republisher.py" name="action_republisher" output="screen" />
    </group>
</launch>
